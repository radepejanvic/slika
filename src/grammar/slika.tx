Program: 
    statements+=Statement
; 

Source: 
    Load | Capture
; 

Statement: 
    Load | Pipeline | Apply | Save | Capture | Show | Comment | Let
; 

Load: 
    'load' path=STRING 'as' name=ID
; 

Pipeline:
    'pipeline' name=ID
    ('(' params+=ID[',']? ')')?
    '{'
        steps+=Step
    '}'
;

Apply:
    'apply' pipeline=PipelineCall 'to' image=[Source]
;

Save: 
    'save' image=[Source] 'to' path=STRING
; 

PipelineCall:
    name=ID ('(' args+=Expr[',']? ')')?
;

Capture: 
    'capture' device=INT 'as' name=ID
;

Show: 
    'show' image=[Source]
; 

Comment: 
    /\/\/.*$/
;

Let: 
    'let' name=ID '=' value=Expr
;

Expr:
    op=Term (op0+=PlusOrMinus op1+=Term)*
;

Term: 
    op=Factor (op0+=MulOrDiv op1+=Factor)*
;

Factor:
    INT | ID | '(' Expr ')'
;

PlusOrMinus: '+' | '-';
MulOrDiv: '*' | '/';

Step:
    SimpleStep | Resize | Crop | ConvertColor |
    Threshold | Erode | Dilate | Opening |
    Closing | Canny
;

SimpleStep: 
    op='dummy'
;

Resize:
    'resize' 'width=' width=Expr 'height=' height=Expr
;


Crop:
    'crop' 'x=' x=Expr 'y=' y=Expr 'width=' width=Expr 'height=' height=Expr
;


ConvertColor:
    'cvt_color' 'code=' code=ColorConversionCode
;

Threshold: 
    'threshold' 'value=' value=Expr ('max_value=' max_value=Expr)? ('type=' type=ThresholdType)?
;

Erode:
    'erode' ('kernel_size=' kernel_size=Expr)? ('iterations=' iterations=Expr)?
;

Dilate:
    'dilate' ('kernel_size=' kernel_size=Expr)? ('iterations=' iterations=Expr)?
;

Opening:
    'opening' ('kernel_size=' kernel_size=Expr)? ('iterations=' iterations=Expr)?
;

Closing:
    'closing' ('kernel_size=' kernel_size=Expr)? ('iterations=' iterations=Expr)?
;

Canny:
    'canny' 'threshold1=' threshold1=Expr 'threshold2=' threshold2=Expr
;

ColorConversionCode:
    'bgr2rgb' | 'rgb2bgr' | 
    'rgb2gray' | 'bgr2gray' | 'gray2rgb' | 'gray2bgr' |
    'bgr2hsv' | 'rgb2hsv' | 'hsv2bgr' | 'hsv2rgb' |
    'bgr2hls' | 'rgb2hls' | 'hls2bgr' | 'hls2rgb' |
    'bgr2lab' | 'rgb2lab' | 'lab2bgr' | 'lab2rgb' |
    'bgr2luv' | 'rgb2luv' | 'luv2bgr' | 'luv2rgb'
;

ThresholdType: 
    'binary' | 'binary_inv' | 'trunc' | 'tozero' | 'tozero_inv' | 
    'mask' | 'otsu' | 'triangle' | 'dryrun'
;

